{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"$id": "https://nova.local/schema/nova-project-v2.json",
"title": "Nova Studio Project Manifest",
"type": "object",
"additionalProperties": false,
"required": [
"version",
"name",
"files",
"graph"
],
"properties": {
"version": {
"const": 2
},
"name": {
"type": "string",
"minLength": 1
},
"files": {
"type": "array",
"minItems": 1,
"maxItems": 16,
"items": {
"type": "object",
"additionalProperties": false,
"required": [
"path"
],
"properties": {
"path": {
"type": "string",
"pattern": "^[^/\\\\].*\\.(c|C|h|H)$"
}
}
}
},
"graph": {
"type": "object",
"additionalProperties": {
"type": "object",
"additionalProperties": false,
"required": [
"x",
"y"
],
"properties": {
"x": {
"type": "number"
},
"y": {
"type": "number"
}
}
}
}
}
}
