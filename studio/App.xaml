<Application x:Class="NovaStudio.App"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
StartupUri="MainWindow.xaml">
<Application.Resources>
<SolidColorBrush x:Key="NovaBackground" Color="#191C20"/>
<SolidColorBrush x:Key="NovaPanel" Color="#202428"/>
<SolidColorBrush x:Key="NovaPanelRaised" Color="#2A3034"/>
<SolidColorBrush x:Key="NovaBorder" Color="#41494E"/>
<SolidColorBrush x:Key="NovaText" Color="#E8ECF5"/>
<SolidColorBrush x:Key="NovaMuted" Color="#A0ABA8"/>
<SolidColorBrush x:Key="NovaAccent" Color="#8EA69B"/>
<SolidColorBrush x:Key="NovaAccentSoft" Color="#35423C"/>
<SolidColorBrush x:Key="NovaGreen" Color="#A5B9AE"/>
<Style TargetType="TextBlock">
<Setter Property="Foreground" Value="{StaticResource NovaText}"/>
</Style>
<Style TargetType="TabControl">
<Setter Property="Background" Value="{StaticResource NovaBackground}"/>
<Setter Property="Foreground" Value="{StaticResource NovaText}"/>
<Setter Property="BorderBrush" Value="{StaticResource NovaBorder}"/>
</Style>
<Style TargetType="TabItem">
<Setter Property="Foreground" Value="{StaticResource NovaMuted}"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="TabItem">
<Border x:Name="TabBorder" Background="{StaticResource NovaPanel}" BorderBrush="{StaticResource NovaBorder}" BorderThickness="0,0,0,2" Padding="12,7">
<ContentPresenter ContentSource="Header"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsSelected" Value="True">
<Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource NovaAccent}"/>
<Setter Property="Foreground" Value="{StaticResource NovaText}"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
<Style TargetType="Window">
<Setter Property="Background" Value="{StaticResource NovaBackground}"/>
<Setter Property="Foreground" Value="{StaticResource NovaText}"/>
<Setter Property="FontFamily" Value="Segoe UI"/>
</Style>
<Style x:Key="ToolbarButton" TargetType="Button">
<Setter Property="Foreground" Value="{StaticResource NovaText}"/>
<Setter Property="Background" Value="{StaticResource NovaPanelRaised}"/>
<Setter Property="BorderBrush" Value="{StaticResource NovaBorder}"/>
<Setter Property="BorderThickness" Value="1"/>
<Setter Property="Padding" Value="14,7"/>
<Setter Property="Margin" Value="0,0,8,0"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="Button">
<Border Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="3"
Padding="{TemplateBinding Padding}">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter Property="Background" Value="#39433F"/>
</Trigger>
<Trigger Property="IsPressed" Value="True">
<Setter Property="Background" Value="{StaticResource NovaAccentSoft}"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
<Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
<Setter Property="Background" Value="{StaticResource NovaPanelRaised}"/>
<Setter Property="BorderBrush" Value="{StaticResource NovaAccent}"/>
<Setter Property="Foreground" Value="White"/>
<Setter Property="FontWeight" Value="SemiBold"/>
</Style>
</Application.Resources>
</Application>
