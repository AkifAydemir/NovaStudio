<Application x:Class="NovaStudio.App"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
StartupUri="MainWindow.xaml">
<Application.Resources>
<SolidColorBrush x:Key="NovaBackground" Color="#0B0D12"/>
<SolidColorBrush x:Key="NovaPanel" Color="#11151D"/>
<SolidColorBrush x:Key="NovaPanelRaised" Color="#171C26"/>
<SolidColorBrush x:Key="NovaBorder" Color="#262D3B"/>
<SolidColorBrush x:Key="NovaText" Color="#E8ECF5"/>
<SolidColorBrush x:Key="NovaMuted" Color="#7F899C"/>
<SolidColorBrush x:Key="NovaAccent" Color="#45D68A"/>
<SolidColorBrush x:Key="NovaAccentSoft" Color="#173627"/>
<SolidColorBrush x:Key="NovaGreen" Color="#65E2A3"/>
<Style TargetType="Window">
<Setter Property="Background" Value="{StaticResource NovaBackground}"/>
<Setter Property="Foreground" Value="{StaticResource NovaText}"/>
<Setter Property="FontFamily" Value="Segoe UI"/>
</Style>
<Style x:Key="ToolbarButton" TargetType="Button">
<Setter Property="Foreground" Value="{StaticResource NovaText}"/>
<Setter Property="Background" Value="{StaticResource NovaPanelRaised}"/>
<Setter Property="BorderBrush" Value="{StaticResource NovaBorder}"/>
<Setter Property="BorderThickness" Value="1"/>
<Setter Property="Padding" Value="14,7"/>
<Setter Property="Margin" Value="0,0,8,0"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="Button">
<Border Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="8"
Padding="{TemplateBinding Padding}">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter Property="Background" Value="#202635"/>
</Trigger>
<Trigger Property="IsPressed" Value="True">
<Setter Property="Background" Value="{StaticResource NovaAccentSoft}"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
<Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
<Setter Property="Background" Value="{StaticResource NovaAccent}"/>
<Setter Property="BorderBrush" Value="{StaticResource NovaAccent}"/>
<Setter Property="Foreground" Value="White"/>
<Setter Property="FontWeight" Value="SemiBold"/>
</Style>
</Application.Resources>
</Application>
